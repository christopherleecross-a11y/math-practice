ate-columns: 1fr 1fr; gap: 0; } .card { border: 1px dashed #888; height: 2.2in; display: flex; align-items: center; justify-content: center; }\n.strip { height: 1.1cm; border: 1px solid #333; background: #f4e3a1; display: flex; align-items: center; padding-left: 6px; font: 12px system-ui; margin: 3px 0; box-sizing: border-box; }\n.tree { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; text-align: center; margin: 6px 0; } .tree div { border: 1.5px solid #333; height: 30px; border-radius: 6px; }\n.pb { break-after: page; }\n.vocab { border: 1.5px solid #1f5fa8; border-radius: 6px; padding: 3px 10px 4px; margin: 4px 0 6px; font-size: 12px; break-inside: avoid; } .vocab .vt { font: 700 12px system-ui, sans-serif; color: #1f5fa8; } .vocab .vt span { font-weight: 400; color: #555; }\n.vocab div.v { line-height: 1.95; } .vocab img.vm { vertical-align: middle; display: inline; } .vocab .bl { display: inline-block; border-bottom: 1px solid #333; height: 1em; vertical-align: -2px; }"}